# Google Maps Platform key with "Places API (New)" enabled. Powers the business search box.
GOOGLE_MAPS_API_KEY=

# Stripe secret key (sk_test_... for testing, sk_live_... for real payments).
# Leave empty to keep the app free.
STRIPE_SECRET_KEY=
# One-time unlock price in cents (1999 = $19.99) and currency.
PRICE_CENTS=1999
CURRENCY=usd
# Any long random string. Signs unlock codes; changing it invalidates existing unlocks.
UNLOCK_SECRET=
# Your public site address, e.g. https://googleqr.up.railway.app (used for Stripe return links).
PUBLIC_URL=
